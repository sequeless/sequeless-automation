<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator only. Never released or deployed: each module is released on its own.
  Modules take their parent from sequeless-build-parent, not from this POM.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.sequeless</groupId>
  <artifactId>sequeless-automation</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>sequeless-automation</name>
  <description>Automation: triggers, actions, timers and the Store-event ingress.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <repositories>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>
</project>
