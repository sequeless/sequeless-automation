<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Pinned to a released sequeless-build-parent (spec 1). Renovate bumps it. -->
  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.3</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>automation-inprocess-adapter</artifactId>
  <version>0.1.2</version>
  <name>automation-inprocess-adapter</name>
  <description>In-process automation adapter: a synchronous AutomationPort for tests and local development.</description>

  <properties>
    <!-- Opts in to the parent's enforcer ban on Spring, Jena and Lombok (spec 1, section 5). The Spring autoconfiguration lives in automation-spring-boot-autoconfig, so this module has no Spring at all. -->
    <sequeless.enforcer.core.skip>false</sequeless.enforcer.core.skip>
    <!-- Deploy namespace (spec 15, section 6). Without it the parent deploys to sequeless-build and gets a 403. -->
    <sequeless.github.repository>sequeless-automation</sequeless.github.repository>
    <assertj.version>3.27.7</assertj.version>
    <junit.version>6.1.3</junit.version>
    <!-- The parent does not manage slf4j, so the version is pinned here. 2.0.17 is the version already resolved from the Maven cache. -->
    <slf4j.version>2.0.17</slf4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spec 1: library repos import junit-bom in their own POM. The parent does not manage JUnit. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Released kernel versions, as listed in sequeless-bom 0.1.5. A library pins them here rather than importing
           the BOM, whose description says libraries do not import it. The pins also make the transitive
           kernel versions that automation-contract 0.1.0 brings in converge on 0.1.1 (the parent enforces
           dependencyConvergence). -->
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>kernel-identity</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>kernel-values</artifactId>
        <version>0.1.1</version>
      </dependency>
      <!-- The contract is pinned with the kernels, so all three versions sit in one place. schema-contract is the
           contract that automation-contract 0.1.0 brings in; the adapter reads Automation's OntologyVersion. -->
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>automation-contract</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>schema-contract</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-api</artifactId>
      <version>0.1.1</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-values</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-contract</artifactId>
    </dependency>
    <!-- The port reads the ontology version stamp through Automation.ontologyVersion(), so the schema contract is declared. -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>schema-contract</artifactId>
    </dependency>
    <!-- The timer sweep logs a failed timer. The version is pinned in dependencyManagement. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- The recording doubles and the AutomationContract the tests run against. -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-testkit</artifactId>
      <version>0.1.2</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The tests import org.junit.jupiter.api directly, so it is declared as well. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The parent manages the archunit versions. The test imports archunit and archunit-junit5-api, so they stay declared, or dependency:analyze reports them as used undeclared. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>
</project>
