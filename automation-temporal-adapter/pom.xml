<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Pinned to a released sequeless-build-parent (spec 1). Renovate bumps it. -->
  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.3</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>automation-temporal-adapter</artifactId>
  <version>0.1.1</version>
  <name>automation-temporal-adapter</name>
  <description>Automation Temporal adapter: a durable AutomationPort on the Temporal Java SDK.</description>

  <properties>
    <!-- Deploy namespace (spec 15, section 6). Without it the parent deploys to sequeless-build and gets a 403. -->
    <sequeless.github.repository>sequeless-automation</sequeless.github.repository>
    <assertj.version>3.27.7</assertj.version>
    <junit.version>6.1.3</junit.version>
    <!-- The version the prototype's root POM imports for Spring Boot (spring-boot.version there). -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <!-- The version the prototype's root POM pins for the Temporal SDK (temporal.version there). -->
    <temporal.version>1.39.0</temporal.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spec 1: library repos import junit-bom in their own POM. The parent does not manage JUnit. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Consumers import their own BOM (the parent says so). Imported after junit-bom, so junit-bom wins for JUnit. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Released kernel versions, as listed in sequeless-bom 0.1.5. A library pins them here rather than importing
           the BOM, whose description says libraries do not import it. The pins also make the transitive
           kernel versions that automation-contract 0.1.0 brings in converge on 0.1.1 (the parent enforces
           dependencyConvergence). -->
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>kernel-identity</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>kernel-values</artifactId>
        <version>0.1.1</version>
      </dependency>
      <!-- The contracts are pinned together: automation-contract 0.1.0 brings schema-contract 0.1.0 in. -->
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>automation-contract</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>schema-contract</artifactId>
        <version>0.1.0</version>
      </dependency>
      <!-- Temporal versions as the prototype's root POM pins them (temporal.version there). -->
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-sdk</artifactId>
        <version>${temporal.version}</version>
      </dependency>
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-serviceclient</artifactId>
        <version>${temporal.version}</version>
      </dependency>
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-testing</artifactId>
        <version>${temporal.version}</version>
      </dependency>
      <!--
        Convergence pins for the Temporal SDK's gRPC graph, copied from the prototype's root POM. Each pin is the
        highest version any path asks for: guava 33.6.0-jre (gRPC) over 33.4.8-android and 33.6.0-android
        (temporal-sdk, gRPC); error_prone_annotations 2.50.0 (gRPC) over 2.41.0, 2.36.0 and 2.18.0.
      -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.6.0-jre</version>
      </dependency>
      <dependency>
        <groupId>com.google.errorprone</groupId>
        <artifactId>error_prone_annotations</artifactId>
        <version>2.50.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-api</artifactId>
      <version>0.1.1</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-values</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>schema-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.temporal</groupId>
      <artifactId>temporal-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>io.temporal</groupId>
      <artifactId>temporal-serviceclient</artifactId>
    </dependency>
    <!-- Only TemporalAutomationProperties uses Spring, for @ConfigurationProperties. Optional: the autoconfiguration
         module brings Spring in, and this adapter does not need it to run. -->

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-testkit</artifactId>
      <version>0.1.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The tests import org.junit.jupiter.api directly, so it is declared as well. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- TestWorkflowEnvironment and WorkflowReplayer: an in-memory Temporal test service, no live server. -->
    <dependency>
      <groupId>io.temporal</groupId>
      <artifactId>temporal-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The parent manages the archunit versions. The test imports archunit and archunit-junit5-api, so they stay declared, or dependency:analyze reports them as used undeclared. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>
</project>
