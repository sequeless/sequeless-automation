<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Pinned to a released sequeless-build-parent (spec 1). Renovate bumps it. -->
  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.3</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>automation-testkit</artifactId>
  <version>0.1.0</version>
  <name>automation-testkit</name>
  <description>Automation testkit: the AutomationPort contract and in-memory test doubles for the automation API.</description>

  <properties>
    <!-- Opts in to the parent's enforcer ban on Spring, Jena and Lombok (spec 1, section 5). -->
    <sequeless.enforcer.core.skip>false</sequeless.enforcer.core.skip>
    <!-- Deploy namespace (spec 15, section 6). Without it the parent deploys to sequeless-build and gets a 403. -->
    <sequeless.github.repository>sequeless-automation</sequeless.github.repository>
    <assertj.version>3.27.7</assertj.version>
    <junit.version>6.1.3</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spec 1: library repos import junit-bom in their own POM. The parent does not manage JUnit. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Released kernel versions, as listed in sequeless-bom 0.1.5. A library pins them here rather than importing
           the BOM, whose description says libraries do not import it. The pins also make the transitive
           kernel versions that automation-contract 0.1.0 brings in converge on 0.1.1 (the parent enforces
           dependencyConvergence). -->
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>kernel-identity</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>kernel-values</artifactId>
        <version>0.1.1</version>
      </dependency>
      <!-- The contract is pinned with the kernels, so all three versions sit in one place. -->
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>automation-contract</artifactId>
        <version>0.1.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-api</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-values</artifactId>
    </dependency>
    <!-- AutomationContract names the ontology automation types directly, so the contract is declared here. -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-contract</artifactId>
    </dependency>

    <!-- Compile scope, not test: AutomationContract lives in src/main/java and adapter modules extend it from
         their own tests, so JUnit and AssertJ must propagate. Mirrors sequeless-spi-testkit. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
    </dependency>

    <!-- Test-only: the engine that runs this module's own tests, and ArchUnit for the boundary test. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The parent manages the archunit versions. The test imports archunit and archunit-junit5-api, so they stay declared, or dependency:analyze reports them as used undeclared. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>
</project>
