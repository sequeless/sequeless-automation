<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Pinned to a released sequeless-build-parent (spec 1). Renovate bumps it. -->
  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.3</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>automation-spring-boot-autoconfig</artifactId>
  <version>0.1.0</version>
  <name>automation-spring-boot-autoconfig</name>
  <description>Spring Boot auto-configuration for the automation modules: the core beans, and one adapter selected by sequeless.automation.adapter.</description>

  <properties>
    <!-- Deploy namespace (spec 15, section 6). Without it the parent deploys to sequeless-build and gets a 403. -->
    <sequeless.github.repository>sequeless-automation</sequeless.github.repository>
    <junit.version>6.1.3</junit.version>
    <!-- The version the prototype's root POM imports for Spring Boot (spring-boot.version there). -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <!-- The version the prototype's root POM pins for the Temporal SDK (temporal.version there). -->
    <temporal.version>1.39.0</temporal.version>
    <!-- The parent does not manage slf4j, so the version is pinned here (as automation-core pins it). -->
    <slf4j.version>2.0.17</slf4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spec 1: library repos import junit-bom in their own POM. The parent does not manage JUnit. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Imported after junit-bom, so junit-bom wins for JUnit. Spring Boot's BOM also manages AssertJ. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Released kernel versions, as listed in sequeless-bom 0.1.5 (the same pins the adapter modules use). -->
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>kernel-identity</artifactId>
        <version>0.1.1</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>kernel-values</artifactId>
        <version>0.1.1</version>
      </dependency>
      <!-- The expression port the action executor renders templates through (automation-core, section 5). -->
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>expression-api</artifactId>
        <version>0.1.1</version>
      </dependency>
      <!-- The ontology contracts are released at 0.1.0 and pinned together, as automation-core pins them. -->
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>schema-contract</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>behaviour-contract</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.sequeless</groupId>
        <artifactId>automation-contract</artifactId>
        <version>0.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <!-- Temporal versions as the prototype's root POM pins them (temporal.version there). -->
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-sdk</artifactId>
        <version>${temporal.version}</version>
      </dependency>
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-serviceclient</artifactId>
        <version>${temporal.version}</version>
      </dependency>
      <!--
        Convergence pins for the Temporal SDK's gRPC graph, copied from automation-temporal-adapter's POM (which copied
        them from the prototype's root POM). Without them the optional Temporal dependency fails dependencyConvergence.
      -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.6.0-jre</version>
      </dependency>
      <dependency>
        <groupId>com.google.errorprone</groupId>
        <artifactId>error_prone_annotations</artifactId>
        <version>2.50.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Core is always wired: the action executor and the trigger evaluator. -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-core</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-api</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>expression-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>schema-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>behaviour-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- The two adapters are optional: a host puts on its classpath only the one it selects. The autoconfigurations
         that need an adapter are guarded by @ConditionalOnClass, so the module loads without either. -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-inprocess-adapter</artifactId>
      <version>0.1.0</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-temporal-adapter</artifactId>
      <version>0.1.0</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.temporal</groupId>
      <artifactId>temporal-sdk</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.temporal</groupId>
      <artifactId>temporal-serviceclient</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>

    <!-- Test scope. The in-process adapter and the core supply the test beans, and the testkit supplies the in-memory
         ports and the recording doubles. -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>automation-testkit</artifactId>
      <version>0.1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-values</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The tests import org.junit.jupiter.api directly, so it is declared as well. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ApplicationContextRunner and FilteredClassLoader come from spring-boot-test, as in the expression autoconfigure
         module. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The test bytecode names spring-beans types through the context runner's assertable context. No main code uses it. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-beans</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The parent manages the archunit versions. The boundary test imports archunit and archunit-junit5-api, so they stay declared. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>
</project>
